FROM docker.io/library/ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG ROS_APT_SOURCE_VERSION=1.3.0
ARG ROS_APT_SOURCE_SHA256=f31d84adf5054c7d60ded0e82c0f776a77ea33af53d08f40b9ad7c94cca55296

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The same Ubuntu Debs installation requested by the course.
# Follow the course's apt installation and receive Noble/Jazzy updates.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash-completion ca-certificates curl git locales vim openssh-client \
        software-properties-common sudo tzdata \
        libegl-mesa0 libgl1-mesa-dri libglx-mesa0 mesa-utils x11-apps \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 \
    && ln -snf /usr/share/zoneinfo/Europe/Rome /etc/localtime \
    && echo Europe/Rome > /etc/timezone \
    && sed -i -E '/^Suites: noble( |$)/c\Suites: noble noble-updates noble-backports' \
        /etc/apt/sources.list.d/ubuntu.sources \
    && add-apt-repository --yes universe \
    && curl --fail --show-error --location --retry 3 \
        --output /tmp/ros2-apt-source.deb \
        "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.noble_all.deb" \
    && printf '%s  /tmp/ros2-apt-source.deb\n' "$ROS_APT_SOURCE_SHA256" | sha256sum --check - \
    && dpkg -i /tmp/ros2-apt-source.deb \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        ros-jazzy-desktop \
        ros-dev-tools \
        python3-colcon-common-extensions \
        python3-colcon-mixin \
        python3-colcon-clean \
    && rosdep init \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/ros2-apt-source.deb

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    TZ=Europe/Rome \
    ROS_DISTRO=jazzy \
    ROS_VERSION=2 \
    ROS_PYTHON_VERSION=3 \
    ROS_DOMAIN_ID=0 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    QT_QPA_PLATFORM=xcb

# Noble's base image can already contain an "ubuntu" account with UID 1000.
RUN if id ubuntu >/dev/null 2>&1; then userdel --remove ubuntu; fi \
    && if getent group ubuntu >/dev/null 2>&1; then groupdel ubuntu; fi \
    && groupadd --gid 1000 ros \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash ros \
    && printf 'ros ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/ros \
    && chmod 0440 /etc/sudoers.d/ros \
    && visudo --check --file /etc/sudoers.d/ros \
    && mkdir -p /workspace/ws/src \
    && chown -R ros:ros /workspace

COPY .devcontainer/ros-env.sh /etc/profile.d/ros-jazzy.sh
COPY .devcontainer/ros-entrypoint.sh /usr/local/bin/ros-entrypoint
RUN chmod 0755 /usr/local/bin/ros-entrypoint \
    && printf '\nsource /etc/profile.d/ros-jazzy.sh\n' >> /home/ros/.bashrc \
    && printf '\nsource /etc/profile.d/ros-jazzy.sh\n' >> /root/.bashrc

# This account is created with an explicit UID/GID in the layer above.
# hadolint ignore=DL3066
USER ros
WORKDIR /home/ros
RUN colcon mixin add default \
        https://raw.githubusercontent.com/colcon/colcon-mixin-repository/master/index.yaml \
    && colcon mixin update default

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/ros-entrypoint"]
CMD ["/bin/bash"]
